module sr_ff_tb;

reg clk;
reg s, r;
wire q;

sr_ff dut(
    .clk(clk),
    .s(s),
    .r(r),
    .q(q)
);

initial begin
    $dumpfile("sr_ff.vcd");
    $dumpvars(0, sr_ff_tb);

    $monitor("time=%0t, clk=%b, s=%b, r=%b, q=%b",
              $time, clk, s, r, q);

    clk = 0;
    s = 0;
    r = 0;

    #10 s = 1; r = 0;   // Set
    #10 s = 0; r = 0;   // Hold
    #10 s = 0; r = 1;   // Reset
    #10 s = 0; r = 0;   // Hold
    #10 s = 1; r = 1;   // Invalid
    #10 s = 0; r = 0;   // Hold

    #10 $finish;
end

always #5 clk = ~clk;

endmodule