module dff_tb;

reg d, clk;
wire q;

dff dut(
    .d(d),
    .clk(clk),
    .q(q)
);

initial begin
    $dumpfile("dff.vcd");
    $dumpvars(0, dff_tb);

    clk = 0;
    d = 0;

    #5  d = 1;
    #5  d = 0;
    #5  d = 1;
    #5  d = 0;

    #10 $finish;
end

always #2.5 clk = ~clk;

initial begin
    $monitor("time=%0t, d=%b, clk=%b, q=%b", $time, d, clk, q);
end

endmodule